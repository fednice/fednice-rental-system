rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function landlordCanUse(uid) {
      let profile = get(/databases/$(database)/documents/landlords/$(uid));
      return request.auth != null
        && request.auth.uid == uid
        && profile.data != null
        && (!('emailVerificationRequired' in profile.data)
          || profile.data.emailVerificationRequired != true
          || request.auth.token.email_verified == true)
        && (!('subscriptionStatus' in profile.data)
          || profile.data.subscriptionStatus == 'active'
          || (profile.data.subscriptionStatus == 'trial'
            && 'trialEndsAt' in profile.data
            && request.time < profile.data.trialEndsAt))
        && (!('subscriptionEndsAt' in profile.data)
          || request.time < profile.data.subscriptionEndsAt);
    }

    // Landlord profiles are created and maintained by the trusted backend.
    match /landlords/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid
        && (!('emailVerificationRequired' in resource.data)
          || resource.data.emailVerificationRequired != true
          || request.auth.token.email_verified == true);
      allow create, update, delete: if false;

      // The browser may manage only the landlord's own house and tenant records.
      match /houses/{houseId} {
        allow read, create, update, delete: if landlordCanUse(uid);
      }
      match /tenants/{tenantId} {
        allow read, delete: if landlordCanUse(uid);
        // Tenant login links are created and revoked only by the trusted backend.
        // This prevents a browser client from attaching somebody else's Firebase UID.
        allow create: if landlordCanUse(uid)
          && !('tenantUid' in request.resource.data)
          && !('accountCreatedAt' in request.resource.data)
          && !('tenantAccessRevokedAt' in request.resource.data);
        allow update: if landlordCanUse(uid)
          && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['tenantUid', 'accountCreatedAt', 'tenantAccessRevokedAt']);
      }

      // Payment records are created/reviewed by the backend only.
      match /payments/{paymentId} {
        allow read, write: if false;
      }
    }

    // OTP challenges, tenant credentials/access codes, and receipt claims are backend-only.
    match /activationChallenges/{documentId} { allow read, write: if false; }
    match /tenantAccessCodes/{documentId} { allow read, write: if false; }
    match /tenantCredentials/{documentId} { allow read, write: if false; }
    match /mpesaReceiptClaims/{documentId} { allow read, write: if false; }
    match /landlordPaymentVerifications/{documentId} { allow read, write: if false; }
    match /landlordPaymentClaims/{documentId} { allow read, write: if false; }
    match /landlordRegistrationIntents/{uid} { allow read, write: if false; }

    // Deny every collection not explicitly listed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
